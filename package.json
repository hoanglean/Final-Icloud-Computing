{
  "name": "v-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "V-Inventory - Quan ly kho va dinh gia dong voi PostgreSQL",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:check": "node scripts/db-check.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11"
  }
}
