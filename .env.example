PORT=3000
# DATABASE_URL là bắt buộc. Tài khoản chỉ được lưu trong PostgreSQL trên Supabase.
# Sao chép chuỗi Session pooler từ Supabase > Connect. Mã hóa ký tự đặc biệt trong mật khẩu.
SUPABASE_PROJECT_REF=gbkchphcndmaoaopuqpv
DATABASE_URL=
# Nếu cần chứng chỉ CA riêng, tải từ Supabase > Database > Settings.
DATABASE_SSL_CA_FILE=database/certs/supabase-ca.crt
